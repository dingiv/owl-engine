/target
# Cargo.lock **入库**(应用/二进制仓):`cargo build --locked` 才能复现依赖树。
# 公共库形态另行裁决时再移出。
AGENTS.md
*.local.md
roadmap.local/
target
__pycache__
crates/*-bak
dev_log
# testdata:bins 大件忽略,但金标生成脚本 + manifest(可复现配方)必须进版本
# (M1 教训:资产/金标无版本 = 哨兵失明;operator-contract 设计 §4.9)
testdata/*
# 快速测试系统说明(唯一 env OWL_TEST_CONF + testdata/cases overlay):说明文档进版本
!testdata/README.md
# 资源清单:示例进版本,本机路径不进
!testdata/resources.toml.example
!testdata/cases/
testdata/cases/*
!testdata/cases/README.md
testdata/resources.toml
# E2E/专项夹具必须进版本(`e2e.rs` 用 `include_str!` 读它 —— 缺了干净检出构建不了)
!testdata/args/
testdata/args/*
!testdata/args/e2e-27b.toml
!testdata/args/prefix-reuse-27b.toml
!testdata/gdn_fla/
testdata/gdn_fla/*
!testdata/gdn_fla/gen.py
!testdata/gdn_fla/gen_c5_deep.py
!testdata/gdn_fla/harvest_fork.py
!testdata/gdn_fla/cases/
testdata/gdn_fla/cases/*
!testdata/gdn_fla/cases/*.json

# kernels build 中间物(链接面 = prebuilt/*.a;.o 为 FORCE_BUILD 中间产物)
crates/kernels/cu/flashinfer/*.o
/*.toml
# 例外:许可证门配置必须入库(/*.toml 只用于挡本机 owl.toml)
!/deny.toml

docs/archive
# perf 会话产物(2026-10-15):原始账太大、且是本地运行快照,不入库
perf-runs/
# bench 原始数据(2026-10-16):只入 .md 战报,数据一律不入库。
# 教训:数据是**未跟踪**的 ⇒ `git add -A` 会静默把它扫进提交(本仓真踩过:
# 别人的 stash 残留被我的 `add -A` 带进一笔,事后加了撤销提交)。
# 进版本 = 真需要当"金标"的数据请显式 `git add -f`。
docs/bench/data/
*.local

/models
# 子 crate 里误生成的独立 lock(工作区统一用根 Cargo.lock)
crates/*/Cargo.lock
