+// ---------------------------------------------------------------------------
+// owl FP16-PV experiment (2026-11-02)
+//
+// FlashAmpere's `flashinfer_fp16pv` recipe: accumulate the PV fragment in pure
+// half (`f16f16f16` HMMA, 4 regs/fragment) instead of float (8 regs), then
+// materialize back to the kept float `o_frag[8]` after the KV loop.  On GA10x
+// consumer Ampere the fp16-accum HMMA runs at 2x the fp32-accum rate, and at
+// hd256 the fp32 accumulator is what pushes the kernel into the 255-reg cap
+// with stack spill.  The spill relief is the dominant effect.
+//
+// Gate: compile-time `OWL_FP16_PV` (build.rs, experiment only) AND DTypeQ=half.
+// bf16 MUST NOT take this path: f16f16f16 would read bf16 bits as fp16.
+// VO-split (fp4 hd>=512) keeps the original fp32 path; owl's production hd256
+// f16/fp8 prefill is the non-VO-split path.
+// ---------------------------------------------------------------------------
+#ifndef OWL_FP16_PV
+#define OWL_FP16_PV 0
+#endif
+
+#if defined(__CUDA_ARCH__) && (OWL_FP16_PV != 0)
+// 只验证过 GeForce GA10x(sm_86)。A100/A40/A6000 的 fp32 累加全速,
+// 且 fp16 累加精度更低;sm_89 也未验证。别用 `>=860` 当判据。
+static_assert(__CUDA_ARCH__ == 860, "OWL_FP16_PV is only validated for sm_86");
+#endif
+
+template <typename KTraits>
+inline constexpr bool owl_pv16_v =
+    (OWL_FP16_PV != 0) && std::is_same_v<typename KTraits::DTypeQ, half> &&
+    (std::is_same_v<typename KTraits::DTypeKV, half> ||
+     sizeof(typename KTraits::DTypeKV) == 1) &&
+    !KTraits::USE_VO_SPLIT;
+template <typename KTraits>
+using OwlOFragT =
+    std::conditional_t<owl_pv16_v<KTraits>, uint32_t, float>;
+template <typename KTraits>
+inline constexpr uint32_t OWL_O_NREG = owl_pv16_v<KTraits> ? 4u : 8u;
+
+/// Convert the accumulator (half-packed or float) into the float fragment the
+/// downstream sync/transform/write helpers expect.  The half path's register
+/// order is C[0..3] = (row r, cols 0/1), (row r+8, cols 0/1), (row r, cols 8/9),
+/// (row r+8, cols 8/9); materializing half2[i] into floats [2i,2i+1] preserves
+/// that order, matching the original float C[8] layout.
+template <typename KTraits, uint32_t NQ, uint32_t ND>
+__device__ __forceinline__ void owl_materialize_o_frag(
+    const OwlOFragT<KTraits> (&o_acc)[NQ][ND][OWL_O_NREG<KTraits>],
+    float (&o_frag)[NQ][ND][8]) {
+#pragma unroll
+  for (uint32_t mma_q = 0; mma_q < NQ; ++mma_q) {
+#pragma unroll
+    for (uint32_t mma_d = 0; mma_d < ND; ++mma_d) {
+      if constexpr (owl_pv16_v<KTraits>) {
+#pragma unroll
+        for (uint32_t h = 0; h < 4; ++h) {
+          const float2 f = __half22float2(((const half2*)o_acc[mma_q][mma_d])[h]);
+          o_frag[mma_q][mma_d][h * 2 + 0] = f.x;
+          o_frag[mma_q][mma_d][h * 2 + 1] = f.y;
+        }
+      } else {
+#pragma unroll
+        for (uint32_t reg_id = 0; reg_id < 8; ++reg_id) {
+          o_frag[mma_q][mma_d][reg_id] = o_acc[mma_q][mma_d][reg_id];
+        }
+      }
+    }
+  }
+}
