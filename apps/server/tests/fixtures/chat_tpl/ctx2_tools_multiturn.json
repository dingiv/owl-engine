{
  "messages": [
    {
      "role": "system",
      "content": "You are pi, a coding agent."
    },
    {
      "role": "user",
      "content": "看看目录"
    },
    {
      "role": "assistant",
      "content": "",
      "reasoning_content": "我需要先列目录,再决定下一步。",
      "tool_calls": [
        {
          "id": "call_1",
          "type": "function",
          "function": {
            "name": "bash",
            "arguments": {
              "command": "ls -la"
            }
          }
        }
      ]
    },
    {
      "role": "tool",
      "content": "exit code: 0\ntotal 4\ndrwxr-xr-x 1 div div 4096 hello.txt",
      "tool_call_id": "call_1"
    },
    {
      "role": "user",
      "content": "现在把它改成 HELLO"
    },
    {
      "role": "assistant",
      "content": "我先读出来再写。",
      "reasoning_content": "改动前先读。",
      "tool_calls": [
        {
          "id": "call_2",
          "type": "function",
          "function": {
            "name": "read",
            "arguments": {
              "path": "hello.txt"
            }
          }
        },
        {
          "id": "call_3",
          "type": "function",
          "function": {
            "name": "bash",
            "arguments": {
              "command": "cat hello.txt"
            }
          }
        }
      ]
    },
    {
      "role": "tool",
      "content": "Exception: file not found: hello.txt",
      "tool_call_id": "call_2"
    },
    {
      "role": "tool",
      "content": "command not found: cat",
      "tool_call_id": "call_3"
    }
  ],
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "bash",
        "description": "Run a shell command. Use <cmd> carefully & wisely.",
        "parameters": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "description": "命令,支持中文"
            },
            "timeout": {
              "type": "number",
              "default": 30
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "read",
        "description": "Read a file",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    }
  ],
  "add_generation_prompt": true,
  "chat_template_kwargs": {
    "enable_thinking": true,
    "preserve_thinking": true
  }
}
